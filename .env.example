# ===========================================
# Environment Variables - Billetterie Transport
# ===========================================
# Copier ce fichier en .env et remplir les valeurs

# ============ PostgreSQL Databases ============

# Auth Service Database
AUTH_DB_HOST=auth-db
AUTH_DB_PORT=5432
AUTH_DB_NAME=auth
AUTH_DB_USER=auth_user
AUTH_DB_PASSWORD=auth_password_change_me

# Booking Service Database
BOOKING_DB_HOST=booking-db
BOOKING_DB_PORT=5432
BOOKING_DB_NAME=booking
BOOKING_DB_USER=booking_user
BOOKING_DB_PASSWORD=booking_password_change_me

# Place Service Database
PLACE_DB_HOST=place-db
PLACE_DB_PORT=5432
PLACE_DB_NAME=places
PLACE_DB_USER=place_user
PLACE_DB_PASSWORD=place_password_change_me

# Partner Service Database
PARTNER_DB_HOST=partner-db
PARTNER_DB_PORT=5432
PARTNER_DB_NAME=partner
PARTNER_DB_USER=partner_user
PARTNER_DB_PASSWORD=partner_password_change_me

# ============ Service URLs ============

# Auth Service
AUTH_SERVICE_URL=http://auth-service:8081

# Booking Service
BOOKING_SERVICE_URL=http://booking-service:8082

# Place Service (gRPC)
PLACE_SERVICE_HOST=place-service
PLACE_SERVICE_GRPC_PORT=9090
PLACE_SERVICE_HTTP_PORT=8083

# Partner Service (SOAP)
PARTNER_WSDL_URL=http://partner-service:8084/ws/partner?wsdl

# ============ JWT Configuration ============

# Secret for signing JWT tokens (MUST BE CHANGED IN PRODUCTION)
JWT_SECRET=your-256-bit-secret-key-change-this-in-production-use-strong-random-value
JWT_EXPIRATION_MS=86400000
# 86400000 ms = 24 hours

# JWKS endpoint (for resource servers)
JWT_ISSUER=http://auth-service:8081
JWKS_URL=http://auth-service:8081/.well-known/jwks.json

# ============ Business Rules ============

# Reservation hold time (minutes)
RESERVATION_HOLD_MINUTES=10

# Maximum places per reservation
MAX_PLACES_PER_RESERVATION=6

# ============ Resilience Configuration ============

# Circuit breaker settings
CIRCUIT_BREAKER_FAILURE_RATE_THRESHOLD=50
CIRCUIT_BREAKER_WAIT_DURATION_SECONDS=10

# Retry settings
RETRY_MAX_ATTEMPTS=3
RETRY_WAIT_DURATION_MS=200

# Timeout settings (milliseconds)
GRPC_CALL_TIMEOUT_MS=2000
SOAP_CONNECTION_TIMEOUT_MS=3000
SOAP_READ_TIMEOUT_MS=5000

# ============ Partner Service Mode ============

# SIMULATED or REAL
PARTNER_MODE=SIMULATED

# Only for REAL mode
PARTNER_EXTERNAL_URL=https://partner-company-api.example.com/soap
PARTNER_EXTERNAL_USER=partner_username
PARTNER_EXTERNAL_PASSWORD=partner_password

# ============ Monitoring & Observability ============

# Logging level
LOGGING_LEVEL_ROOT=INFO
LOGGING_LEVEL_COM_BILLETTERIE=DEBUG

# ============ Docker Network ============
COMPOSE_PROJECT_NAME=billetterie-transport
